<template>
  <view class="frame">
    <view class="main">

      <view class="sectionDateSelectorC">
        <view class="container3">
          <image src="/static/mnkccmjp-nk2yee9.svg" class="backgroundShadow"></image>
          <view class="container2">
            <view class="container">
              <text class="text">统计日期</text>
            </view>
            <text class="text2">{{currentDate}}</text>
          </view>
        </view>
      </view>
      <view class="summaryGrid">
        <view class="avgHeartRateCard">
          <view class="backgroundShadow2">
            <image src="/static/mnkccmjp-785xihs.svg" class="container5"></image>
          </view>
          <view class="container6">
            <text class="text3">平均心率</text>
            <view class="paragraph">
              <text class="text4">{{avgHeartRate}}</text>
              <text class="text5">BPM</text>
            </view>
          </view>
          <view class="container7">
            <view class="overlay" :style="{ backgroundColor: healthStatus.bgColor }">
              <text class="text6" :style="{ color: healthStatus.color }">{{ healthStatus.text }}</text>
            </view>
          </view>
        </view>
        <view class="averageTemperatureCa">
          <view class="backgroundShadow3">
            <image src="/static/mnkccmjp-9qfczoj.svg" class="container8"></image>
          </view>
          <view class="container9">
            <text class="text3">平均体温</text>
            <view class="paragraph2">
              <text class="text7">{{avgTemperature}}</text>
              <text class="text8">°C</text>
            </view>
          </view>
          <view class="container11">
            <image src="/static/mnkccmjp-oenwdlf.svg" class="container10"></image>
            <text class="text9" :style="{ color: temperatureStatus.color }">{{ temperatureStatus.text }}</text>
          </view>
        </view>
      </view>



    </view>
  </view>
</template>

<script setup lang="uts">
  import { ref, onMounted, computed, onUnmounted } from 'vue'
  
  // 动态计算当前日期
  const currentDate = ref('')
  const avgHeartRate = ref(0) // 默认值设置为0
  const avgTemperature = ref(0) // 默认值设置为0
  
  // 存储从OneNet获取的心率和温度数据
  const heartRateData = ref([72, 72, 72, 72, 72]) // 默认数据（相同值）
  const temperatureData = ref([36.6, 36.6, 36.6, 36.6, 36.6]) // 默认数据（相同值）
  
  // 配置
  const config = {
    authorization: "version=2018-10-31&res=products%2FH9At1TTBP4%2Fdevices%2Fclient&et=1900800000&method=md5&sign=CjzWJ2qR1SBv1wEqdS83dw%3D%3D",
    product_id: "H9At1TTBP4",
    device_name: "client",
    getUrl: "https://iot-api.heclouds.com/thingmodel/query-device-property?product_id=H9At1TTBP4&device_name=client"
  }
  
  // 计算平均心率，排除0和255
  const calculateAvgHeartRate = () => {
    // 过滤掉0和255的值
    const validData = heartRateData.value.filter(val => val !== 0 && val !== 255)
    if (validData.length === 0) return 0
    const sum = validData.reduce((acc, val) => acc + val, 0)
    return Math.round(sum / validData.length)
  }
  
  // 计算平均体温，排除0和255
  const calculateAvgTemperature = () => {
    // 过滤掉0和255的值
    const validData = temperatureData.value.filter(val => val !== 0 && val !== 255)
    if (validData.length === 0) return 0
    const sum = validData.reduce((acc, val) => acc + val, 0)
    return parseFloat((sum / validData.length).toFixed(1))
  }
  
  // 根据心率计算健康状态
  const healthStatus = computed(() => {
    const rate = avgHeartRate.value
    if (rate === 0) return { text: '请检测', color: '#64748b', bgColor: 'rgba(100, 116, 139, 0.1)' }
    if (rate < 60) return { text: '心率过缓', color: '#3b82f6', bgColor: 'rgba(59, 130, 246, 0.1)' }
    if (rate >= 60 && rate <= 100) return { text: '健康状态', color: '#10b981', bgColor: 'rgba(16, 185, 129, 0.1)' }
    if (rate > 100 && rate <= 120) return { text: '心率过快', color: '#f59e0b', bgColor: 'rgba(245, 158, 11, 0.1)' }
    return { text: '心率异常', color: '#ef4444', bgColor: 'rgba(239, 68, 68, 0.1)' }
  })
  
  // 根据体温计算状态
  const temperatureStatus = computed(() => {
    const temp = avgTemperature.value
    if (temp === 0) return { text: '请检测', color: '#64748b' }
    if (temp < 36.0) return { text: '体温偏低', color: '#3b82f6' }
    if (temp >= 36.0 && temp <= 37.2) return { text: '体温正常', color: '#10b981' }
    if (temp > 37.2 && temp <= 38.0) return { text: '轻度发热', color: '#f59e0b' }
    if (temp > 38.0 && temp <= 39.0) return { text: '中度发热', color: '#ef4444' }
    return { text: '高热', color: '#dc2626' }
  })
  
  // 更新日期为当前日期
  const updateCurrentDate = () => {
    const now = new Date()
    const year = now.getFullYear()
    const month = String(now.getMonth() + 1).padStart(2, '0')
    const day = String(now.getDate()).padStart(2, '0')
    currentDate.value = `${year}年${month}月${day}日 (今天)`
  }
  
  // 从OneNet获取设备状态
  const getDeviceStatus = () => {
    uni.request({
      url: config.getUrl,
      header: { authorization: config.authorization },
      success: (res: any) => {
        if (res.data.code === 0) {
          const list = res.data.data;
          
          // 心跳
          const heart = list.find((i: any) => i.identifier === "HeartBeat");
          if (heart) {
            // 转换为数字并检查范围
            const heartValue = Number(heart.value);
            // 心率范围检查：正常范围60-100，异常范围30-200
            if (!isNaN(heartValue) && heartValue >= 30 && heartValue <= 200) {
              // 添加到数据数组，最多保存10个数据点
              heartRateData.value.push(heartValue);
              if (heartRateData.value.length > 10) {
                heartRateData.value.shift();
              }
              // 计算平均心率
              avgHeartRate.value = calculateAvgHeartRate();
            }
          }
          
          // 温度
          const temp = list.find((i: any) => i.identifier === "temperature");
          if (temp) {
            // 转换为数字并检查范围
            const tempValue = Number(temp.value);
            // 体温范围检查：正常范围35-42
            if (!isNaN(tempValue) && tempValue >= 35 && tempValue <= 42) {
              // 添加到数据数组，最多保存10个数据点
              temperatureData.value.push(tempValue);
              if (temperatureData.value.length > 10) {
                temperatureData.value.shift();
              }
              // 计算平均体温
              avgTemperature.value = calculateAvgTemperature();
            }
          }
        }
      },
      fail: () => console.log("获取设备状态失败")
    });
  }
  
  let intervalId: number
  onMounted(() => {
    // 更新日期
    updateCurrentDate()
    
    // 获取设备状态
    getDeviceStatus()
    
    // 设置轮询
    intervalId = setInterval(getDeviceStatus, 1000) as unknown as number
    
    console.log('健康页面加载')
  })
  
  onUnmounted(() => {
    clearInterval(intervalId)
  })
</script>

