page { background-color: #f4f6f9; color: #333; }
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
}

.status-card {
  background: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.05);
  margin-bottom: 30rpx;
}
.label { font-size: 26rpx; color: #999; }
.value { font-size: 40rpx; font-weight: bold; color: #007AFF; }

.info-card {
  background: #fff;
  width: 85%;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 50rpx;
}
.info-item {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 10rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.info-value {
  color: #007AFF;
  font-weight: bold;
}
.info-value.red {
  color: #ff4d4f;
}

.control-pad {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 60rpx;
}
.row {
  display: flex;
  justify-content: center;
  gap: 15rpx;
}

.btn-square {
  width: 115rpx !important;
  height: 115rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #ffffff;
  color: #444;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
}
.btn-stop {
  background: #ff4d4f !important;
  color: #fff !important;
}
.btn-speed {
  flex: 1;
  height: 90rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
}
.btn-acc { background: #52c41a; }
.btn-dec { background: #faad14; }

.data-panel {
  width: 85%;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  max-height: 250rpx;
}
.data-val { color: #007AFF; }